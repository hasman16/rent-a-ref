{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular2-full-stack": {
      "root": "",
      "sourceRoot": "client",
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/public",
            "index": "client/index.html",
            "browser": "client/main.ts",
            "tsConfig": "client/tsconfig.app.json",
            "polyfills": ["zone.js"],
            "assets": [
              {
                "glob": "**/*",
                "input": "client/assets"
              },
              {
                "glob": "favicon.ico",
                "input": "client/assets"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/@swimlane/ngx-datatable/index.css",
              "node_modules/@swimlane/ngx-datatable/themes/material.css",
              "node_modules/@swimlane/ngx-datatable/assets/icons.css",
              "client/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "32kb",
                  "maximumError": "64kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "client/app/environments/environment.ts",
                  "with": "client/app/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "polyfills": ["zone.js", "zone.js/testing", "zone.js/plugins/vitest-patch"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular2-full-stack:build:production"
            },
            "development": {
              "buildTarget": "angular2-full-stack:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "angular2-full-stack:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "client/tsconfig.spec.json",
            "buildTarget": "angular2-full-stack:build:testing",
            "exclude": [
              "client/app/shared/forms/blog-form/blog-form.component.spec.ts",
              "client/app/shared/forms/events-form/events-form.component.spec.ts",
              "client/app/shared/forms/matches-form/matches-form.component.spec.ts",
              "client/app/shared/forms/organization-form/organization-form.component.spec.ts",
              "client/app/shared/forms/schedule-address-form/schedule-address-form.component.spec.ts",
              "client/app/shared/forms/statuses-form/statuses-form.component.spec.ts",
              "client/app/shared/forms/address-form/horizontal-address-form/horizontal-address-form.component.spec.ts",
              "client/app/account/account.component.spec.ts",
              "client/app/logout/logout.component.spec.ts",
              "client/app/resetpassword/resetpassword.component.spec.ts"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app"
    },
    "@schematics/angular:directive": {
      "prefix": "app"
    }
  }
}