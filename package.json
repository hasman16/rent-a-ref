{
  "name": "rent-a-ref",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Ahmadou Ndoung",
  "description": "Sports Website project built using Angular, Express and Node.",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "start": "node dist/server/app.js",
    "predev": "tsc -p server",
    "back": "concurrently \"tsc -w -p server\" \"nodemon dist/server/app.js\"",
    "dev": "concurrently \"ng serve --proxy-config proxy.conf.json --open\" \"tsc -w -p server\" \"nodemon dist/server/app.js\"",
    "prod": "concurrently \"ng build && tsc -p server && node dist/server/app.js\"",
    "test": "ng test",
    "testbe": "tsc -p server && mocha dist/server/tests --exit",
    "e2e": "ng e2e",
    "format": "prettier --write \"./client/**/*.+(ts|scss|json)\""
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "private": true,
